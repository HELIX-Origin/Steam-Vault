{
  "name": "universal-game-launcher",
  "version": "1.3.3",
  "description": "A fast, privacy-focused cross-platform universal game library organizer and launcher",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:dev": "node scripts/dev.mjs",
    "tauri:dev:raw": "tauri dev",
    "tauri:build": "node scripts/build.mjs",
    "tauri:build:release": "node scripts/build.mjs release",
    "tauri:build:debug": "node scripts/build.mjs debug",
    "tauri:build:raw": "tauri build",
    "log": "node scripts/run.mjs",
    "test": "node scripts/test.mjs",
    "test:rust": "node scripts/test.mjs rust",
    "test:frontend": "node scripts/test.mjs frontend",
    "test:all": "node scripts/test.mjs all",
    "verify": "node scripts/test.mjs check rust frontend build",
    "sign": "node scripts/sign.mjs",
    "sign:windows": "node scripts/sign.mjs windows",
    "sign:linux": "node scripts/sign.mjs linux",
    "sign:macos": "node scripts/sign.mjs macos"
  },
  "author": "HELIX Origin",
  "license": "BSD-3-Clause",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "sass": "^1.105.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
